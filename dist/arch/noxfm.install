post_install() {
  cat <<'MSG'
==> noxfm installed.
    Start the daemon with your session:   systemctl --user enable --now noxd
    Make noxfm the default for folders:   xdg-mime default dev.noxfm.Browser.desktop inode/directory
    Members of "wheel" can now mount internal disks without a password
    (/usr/share/polkit-1/rules.d/50-noxfm-udisks.rules).
MSG
}

post_upgrade() {
  echo '==> Restart the daemon to use the new version:   systemctl --user restart noxd'
}

pre_remove() {
  echo '==> You may want to stop the daemon:   systemctl --user disable --now noxd'
}
