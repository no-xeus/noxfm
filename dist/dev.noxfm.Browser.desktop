[Desktop Entry]
Type=Application
Name=noxfm
GenericName=File Manager
Comment=Browse and manage files
Exec=noxfm %f
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;Core;
MimeType=inode/directory;
Keywords=files;folders;explorer;browser;
StartupWMClass=dev.noxfm.Browser
