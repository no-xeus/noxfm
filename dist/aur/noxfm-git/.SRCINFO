pkgbase = noxfm-git
	pkgdesc = File manager with a background daemon: live sizes, recent files, drive mounting, tabs
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/no-xeus/noxfm
	install = noxfm.install
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	makedepends = git
	depends = udisks2
	depends = polkit
	depends = wayland
	depends = libxkbcommon
	depends = vulkan-icd-loader
	depends = fontconfig
	depends = gcc-libs
	depends = glibc
	optdepends = ffmpeg: video thumbnails
	optdepends = git: branch and status of repositories in Properties
	optdepends = kitty: "Open in terminal" and terminal apps (any terminal emulator works, see $TERMINAL)
	optdepends = xdg-terminal-exec: use your preferred terminal emulator
	optdepends = hyprpolkitagent: password prompts for actions the noxfm polkit rule does not cover
	optdepends = adwaita-icon-theme: icons when your theme lacks some
	provides = noxfm
	conflicts = noxfm
	options = !lto
	options = !debug
	source = noxfm::git+https://github.com/no-xeus/noxfm.git
	sha256sums = SKIP

pkgname = noxfm-git
