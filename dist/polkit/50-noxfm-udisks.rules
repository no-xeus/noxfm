// noxfm: let local, active members of "wheel" mount and unmount internal
// disks (for example a Windows partition) without typing a password.
//
// Plugged-in drives don't need this: udisks already lets the active user
// mount them. Remove this file to get the password prompt back.
polkit.addRule(function (action, subject) {
    var allowed = [
        "org.freedesktop.udisks2.filesystem-mount-system",
        "org.freedesktop.udisks2.filesystem-unmount-others",
    ];
    if (allowed.indexOf(action.id) >= 0 && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
